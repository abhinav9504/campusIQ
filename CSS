/* =========================================================
   CAMPUSIQ - CINEMATIC UI
========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}


html {
    scroll-behavior: smooth;
}


body {
    font-family: Arial, Helvetica, sans-serif;

    min-height: 100vh;

    color: #ffffff;

    background:
        radial-gradient(
            circle at top right,
            rgba(120, 0, 0, 0.35),
            transparent 35%
        ),
        radial-gradient(
            circle at bottom left,
            rgba(255, 60, 0, 0.08),
            transparent 30%
        ),
        #070707;

    overflow-x: hidden;
}


/* =========================================================
   LOGIN
========================================================= */

#loginPage {
    min-height: 100vh;

    display: flex;

    justify-content: center;

    align-items: center;

    padding: 30px;
}


.login-card {

    width: 100%;

    max-width: 500px;

    padding: 40px;

    background:
        linear-gradient(
            145deg,
            rgba(30, 30, 30, 0.96),
            rgba(8, 8, 8, 0.98)
        );

    border: 1px solid #333;

    border-radius: 12px;

    box-shadow:
        0 0 30px rgba(255, 0, 0, 0.15),
        inset 0 0 25px rgba(255, 0, 0, 0.03);

    position: relative;

    overflow: hidden;
}


.login-card::before {

    content: "";

    position: absolute;

    width: 300px;

    height: 300px;

    border: 1px solid rgba(255, 0, 0, 0.12);

    border-radius: 50%;

    right: -120px;

    top: -80px;

}


.login-card h1 {

    font-size: 34px;

    letter-spacing: 3px;

    color: #ffffff;

    text-shadow:
        0 0 10px rgba(255, 255, 255, 0.5),
        0 0 20px rgba(255, 0, 0, 0.4);

    margin-bottom: 10px;
}


.login-subtitle {

    color: #cccccc;

    letter-spacing: 1px;

    margin-bottom: 30px;
}


.login-form {

    position: relative;

    z-index: 2;
}


.login-form label {

    display: block;

    margin-top: 18px;

    margin-bottom: 7px;

    color: #ffd000;

    font-weight: bold;

    letter-spacing: 1px;

    font-size: 13px;
}


.login-form input {

    width: 100%;

    padding: 13px;

    background: #050505;

    color: white;

    border: 1px solid #444;

    border-radius: 5px;

    outline: none;

    font-size: 15px;
}


.login-form input:focus {

    border-color: #ff3333;

    box-shadow:
        0 0 10px rgba(255, 0, 0, 0.25);
}


.login-form button {

    margin-top: 20px;
}


#loginMessage {

    margin-top: 15px;

    color: #ff4444;

    min-height: 20px;
}


.demo-accounts {

    margin-top: 25px;

    padding: 15px;

    background: rgba(255, 255, 255, 0.03);

    border-left: 3px solid #ffd000;
}


.demo-accounts p {

    color: #ffd000;

    margin-bottom: 8px;

    font-weight: bold;
}


.demo-accounts small {

    display: block;

    color: #bbbbbb;

    margin-top: 5px;
}


/* =========================================================
   HEADER
========================================================= */

header {

    text-align: center;

    padding: 45px 20px 30px;

    background:
        linear-gradient(
            180deg,
            rgba(100, 0, 0, 0.5),
            rgba(10, 10, 10, 0.8)
        );

    border-bottom: 1px solid #5c0000;

    position: relative;

    overflow: hidden;
}


header::before {

    content: "";

    position: absolute;

    width: 380px;

    height: 380px;

    border-radius: 50%;

    border: 1px solid rgba(255, 0, 0, 0.12);

    right: -100px;

    top: -180px;

    box-shadow:
        0 0 30px rgba(255, 0, 0, 0.08);
}


header h1 {

    position: relative;

    font-size: 48px;

    letter-spacing: 7px;

    color: #ffd000;

    text-shadow:
        0 0 8px #ff0000,
        0 0 25px rgba(255, 0, 0, 0.6);

    animation: titleIn 1s ease;
}


header p {

    position: relative;

    margin-top: 10px;

    letter-spacing: 4px;

    color: #dddddd;
}


.system-status {

    display: inline-block;

    margin-bottom: 15px;

    padding: 7px 15px;

    border: 1px solid #3f3f3f;

    border-radius: 20px;

    font-size: 11px;

    letter-spacing: 2px;

    color: #bbbbbb;
}


.status-dot {

    display: inline-block;

    width: 8px;

    height: 8px;

    margin-right: 7px;

    border-radius: 50%;

    background: #00ff66;

    box-shadow: 0 0 10px #00ff66;
}


/* =========================================================
   NAVIGATION
========================================================= */

nav {

    display: flex;

    justify-content: center;

    gap: 12px;

    padding: 15px;

    background: rgba(5, 5, 5, 0.95);

    border-bottom: 1px solid #333;

    position: sticky;

    top: 0;

    z-index: 100;
}


/* =========================================================
   BUTTONS
========================================================= */

button {

    border: 1px solid #ff3333;

    background:
        linear-gradient(
            135deg,
            #a90000,
            #ef2020
        );

    color: white;

    padding: 12px 20px;

    border-radius: 5px;

    cursor: pointer;

    font-weight: bold;

    letter-spacing: 0.5px;

    transition: 0.25s;

    box-shadow:
        0 0 10px rgba(255, 0, 0, 0.15);
}


button:hover {

    transform: translateY(-2px);

    box-shadow:
        0 0 18px rgba(255, 0, 0, 0.45);

    border-color: #ffd000;
}


.ai-button {

    background:
        linear-gradient(
            135deg,
            #6e4a00,
            #d99c00
        );

    border-color: #ffd000;
}


/* =========================================================
   SECTIONS
========================================================= */

section:not(#loginPage) {

    max-width: 1150px;

    margin: 30px auto;

    padding: 30px;

    background:
        rgba(18, 18, 18, 0.85);

    border: 1px solid #2d2d2d;

    border-radius: 10px;

    box-shadow:
        0 0 25px rgba(255, 0, 0, 0.05);
}


section h2 {

    color: #ffd000;

    margin-bottom: 15px;

    letter-spacing: 1px;
}


section p {

    color: #bbbbbb;

    line-height: 1.6;
}


/* =========================================================
   STATS
========================================================= */

.stats {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 15px;

    margin: 25px 0;
}


.stat-card {

    padding: 22px;

    text-align: center;

    background:
        linear-gradient(
            145deg,
            #191919,
            #0c0c0c
        );

    border: 1px solid #333;

    border-radius: 8px;

    transition: 0.3s;
}


.stat-card:hover {

    transform: translateY(-4px);

    border-color: #ff3333;

    box-shadow:
        0 0 20px rgba(255, 0, 0, 0.15);
}


.stat-card h3 {

    font-size: 32px;

    color: #ffd000;

    margin-bottom: 8px;
}


.stat-card p {

    font-size: 12px;

    letter-spacing: 1px;
}


/* =========================================================
   PORTAL ACTIONS
========================================================= */

.portal-actions {

    display: flex;

    gap: 15px;

    flex-wrap: wrap;

    margin: 25px 0;
}


/* =========================================================
   FORMS
========================================================= */

form {

    margin-top: 25px;
}


form label {

    display: block;

    margin-top: 18px;

    margin-bottom: 7px;

    color: #ffd000;

    font-size: 13px;

    font-weight: bold;

    letter-spacing: 1px;
}


input,
textarea,
select {

    width: 100%;

    padding: 13px;

    border-radius: 5px;

    border: 1px solid #444;

    background: #050505;

    color: white;

    font-family: inherit;

    outline: none;
}


textarea {

    resize: vertical;
}


input:focus,
textarea:focus,
select:focus {

    border-color: #ff3333;

    box-shadow:
        0 0 10px rgba(255, 0, 0, 0.2);
}


form button {

    margin-top: 20px;
}


/* =========================================================
   AI PANEL
========================================================= */

.ai-panel {

    margin-top: 25px;

    padding: 25px;

    border: 1px solid #7b5700;

    border-radius: 8px;

    background:
        linear-gradient(
            145deg,
            rgba(65, 45, 0, 0.35),
            rgba(15, 15, 15, 0.9)
        );

    box-shadow:
        0 0 20px rgba(255, 190, 0, 0.08);
}


.ai-header {

    display: flex;

    gap: 15px;

    align-items: center;
}


.ai-header > span {

    font-size: 30px;
}


.ai-header h3 {

    color: #ffd000;

    margin-bottom: 4px;
}


.ai-header small {

    color: #999;

    letter-spacing: 1px;
}


.ai-line {

    height: 1px;

    margin: 20px 0;

    background:
        linear-gradient(
            90deg,
            transparent,
            #ffd000,
            transparent
        );
}


.ai-result {

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 15px;
}


.ai-item {

    padding: 15px;

    background: rgba(0, 0, 0, 0.35);

    border: 1px solid #333;

    border-radius: 5px;
}


.ai-item span {

    display: block;

    color: #888;

    font-size: 11px;

    margin-bottom: 7px;

    letter-spacing: 1px;
}


.ai-item strong {

    color: #ffffff;
}


/* =========================================================
   TICKETS
========================================================= */

#ticketList,
#studentTicketList,
#trackResult {

    margin-top: 20px;
}


.ticket-card {

    margin: 15px 0;

    padding: 22px;

    background:
        linear-gradient(
            145deg,
            #171717,
            #0b0b0b
        );

    border: 1px solid #333;

    border-left: 4px solid #d00000;

    border-radius: 7px;

    transition: 0.25s;
}


.ticket-card:hover {

    border-left-color: #ffd000;

    box-shadow:
        0 0 20px rgba(255, 0, 0, 0.12);
}


.ticket-top {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 15px;

    margin-bottom: 12px;
}


.ticket-top strong {

    color: #ffd000;

    font-size: 18px;
}


.ticket-card h3 {

    color: #ffffff;

    margin: 10px 0;
}


.ticket-card p {

    margin: 7px 0;

    color: #aaa;
}


/* =========================================================
   PRIORITY
========================================================= */

.priority {

    padding: 5px 10px;

    border-radius: 15px;

    font-size: 11px;

    font-weight: bold;

    letter-spacing: 1px;
}


.priority.high {

    background: rgba(255, 0, 0, 0.2);

    border: 1px solid #ff3333;

    color: #ff5555;
}


.priority.medium {

    background: rgba(255, 190, 0, 0.15);

    border: 1px solid #ffd000;

    color: #ffd000;
}


.priority.low {

    background: rgba(0, 255, 100, 0.1);

    border: 1px solid #00cc55;

    color: #00ff66;
}


/* =========================================================
   TICKET STATUS
========================================================= */

.ticket-status {

    display: inline-block;

    margin-top: 12px;

    padding: 8px 12px;

    border: 1px solid #555;

    border-radius: 5px;

    color: #ffffff;

    font-weight: bold;

    font-size: 12px;
}


.ticket-date {

    margin-top: 15px;

    color: #777;

    font-size: 11px;
}


/* =========================================================
   TICKET TIMELINE
========================================================= */

.ticket-timeline {

    display: flex;

    justify-content: space-between;

    gap: 8px;

    margin-top: 22px;

    padding-top: 18px;

    border-top: 1px solid #292929;
}


.timeline-step {

    flex: 1;

    text-align: center;

    color: #555;

    font-size: 11px;

    padding: 8px 3px;
}


.timeline-step.active {

    color: #ffd000;

    text-shadow:
        0 0 8px rgba(255, 208, 0, 0.35);
}


/* =========================================================
   FILTERS
========================================================= */

.filters {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 12px;

    margin: 20px 0;
}


/* =========================================================
   TRACK BOX
========================================================= */

.track-box {

    display: flex;

    gap: 10px;

    margin-top: 25px;
}


.track-box input {

    flex: 1;
}


.track-box button {

    width: auto;
}


/* =========================================================
   ERROR
========================================================= */

.error-message {

    margin-top: 20px;

    padding: 15px;

    color: #ff5555;

    border: 1px solid #7a2222;

    background: rgba(100, 0, 0, 0.15);

    border-radius: 5px;
}


/* =========================================================
   BACK BUTTON
========================================================= */

.back-area {

    text-align: center;

    margin: 30px 0;
}


/* =========================================================
   ANIMATION
========================================================= */

@keyframes titleIn {

    from {

        opacity: 0;

        transform:
            translateY(-20px);

    }

    to {

        opacity: 1;

        transform:
            translateY(0);

    }

}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 800px) {

    header h1 {

        font-size: 34px;

        letter-spacing: 4px;
    }


    .stats {

        grid-template-columns:
            repeat(2, 1fr);
    }


    .ai-result {

        grid-template-columns:
            1fr;
    }


    .filters {

        grid-template-columns:
            1fr;
    }


    nav {

        flex-wrap: wrap;
    }

}


@media (max-width: 550px) {

    #loginPage {

        padding: 15px;
    }


    .login-card {

        padding: 25px;
    }


    section:not(#loginPage) {

        margin: 15px;

        padding: 20px;
    }


    .stats {

        grid-template-columns:
            1fr;
    }


    .ticket-top {

        flex-direction: column;

        align-items: flex-start;
    }


    .ticket-timeline {

        flex-direction: column;
    }


    .track-box {

        flex-direction: column;
    }

}
