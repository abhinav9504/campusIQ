// ============================================================

function trackTicket() {

    const id =
        document.getElementById("trackTicketId")
        .value
        .trim()
        .toUpperCase();


    const result =
        document.getElementById("trackResult");


    const tickets =
        getTickets();


    const ticket =
        tickets.find(function(item) {

            return item.id === id;

        });


    if (!ticket) {

        result.innerHTML = `
            <div class="error-message">
                ❌ Ticket not found.
            </div>
